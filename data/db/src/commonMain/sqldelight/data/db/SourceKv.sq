CREATE TABLE source_kv (
  source_key TEXT NOT NULL,
  data_key TEXT NOT NULL,
  value_json TEXT NOT NULL,
  PRIMARY KEY(source_key, data_key)
);

putKv:
INSERT OR REPLACE INTO source_kv (source_key, data_key, value_json)
VALUES (?, ?, ?);

getKv:
SELECT value_json FROM source_kv WHERE source_key = ? AND data_key = ?;

deleteKv:
DELETE FROM source_kv WHERE source_key = ? AND data_key = ?;
