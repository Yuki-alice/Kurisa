CREATE TABLE shelf_item (
  shelf_id TEXT NOT NULL REFERENCES shelf(id) ON DELETE CASCADE,
  work_id TEXT NOT NULL REFERENCES work(id) ON DELETE CASCADE,
  added_at INTEGER NOT NULL,
  PRIMARY KEY(shelf_id, work_id)
);

addToShelf:
INSERT OR REPLACE INTO shelf_item (shelf_id, work_id, added_at)
VALUES (?, ?, ?);

removeFromShelf:
DELETE FROM shelf_item WHERE shelf_id = ? AND work_id = ?;

selectShelfItems:
SELECT * FROM shelf_item WHERE shelf_id = ? ORDER BY added_at DESC;
