CREATE TABLE shelf (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  ordinal INTEGER NOT NULL,
  source_folder_id TEXT
);

upsertShelf:
INSERT OR REPLACE INTO shelf (id, name, ordinal, source_folder_id)
VALUES (?, ?, ?, ?);

selectShelves:
SELECT * FROM shelf ORDER BY ordinal;

deleteShelf:
DELETE FROM shelf WHERE id = ?;
