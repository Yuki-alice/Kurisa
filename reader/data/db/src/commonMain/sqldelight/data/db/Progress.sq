CREATE TABLE reading_progress (
  work_id TEXT PRIMARY KEY,
  chapter_id TEXT NOT NULL,
  page_index INTEGER,
  scroll_offset REAL,
  percent REAL NOT NULL,
  updated_at INTEGER NOT NULL,
  synced INTEGER NOT NULL DEFAULT 0
);

upsertProgress:
INSERT OR REPLACE INTO reading_progress
  (work_id, chapter_id, page_index, scroll_offset, percent, updated_at, synced)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectProgress:
SELECT * FROM reading_progress WHERE work_id = ?;

markSynced:
UPDATE reading_progress SET synced = 1 WHERE work_id = ?;

deleteProgress:
DELETE FROM reading_progress WHERE work_id = ?;
